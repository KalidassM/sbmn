# Reference for the environment variables to paste into Railway's
# service "Variables" tab (Raw Editor). Not read directly by anything -
# fill in the real values there, not in this file.

APP_NAME="Sri Balamurugan Nagar Welfare Association"
APP_ENV=production
APP_KEY=                         # generate locally with `php artisan key:generate --show`, paste the output
APP_DEBUG=false
APP_URL=                         # your Railway backend domain, e.g. https://sbmn-backend-production.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Railway's Postgres plugin auto-generates DB_* variables when you add it
# to the project (or one DATABASE_URL) - copy them in, or reference them
# directly if Railway lets you link variables across services.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Photo uploads: Railway's own filesystem is wiped on every deploy, so
# uploads go to an S3-compatible bucket instead (e.g. Cloudflare R2 free
# tier). Leave UPLOADS_DISK=public only if you're fine with photos being
# lost on every redeploy.
UPLOADS_DISK=s3
AWS_ACCESS_KEY_ID=               # R2 API token "Access Key ID"
AWS_SECRET_ACCESS_KEY=           # R2 API token "Secret Access Key"
AWS_DEFAULT_REGION=auto
AWS_BUCKET=                      # your R2 bucket name
AWS_ENDPOINT=                    # https://<account-id>.r2.cloudflarestorage.com
AWS_URL=                         # your R2 bucket's public URL (enable public access first)
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email notifications for the contact form (see MAIL_MAILER=resend setup
# from earlier in this project).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Sri Balamurugan Nagar Welfare Association"
COMMITTEE_NOTIFY_EMAIL=
